RewriteEngine On
DirectoryIndex index.html

<IfModule mod_headers.c>
	<FilesMatch "\.(html?)$">
		Header set Cache-Control "no-cache, no-store, must-revalidate"
		Header set Pragma "no-cache"
		Header set Expires "0"
	</FilesMatch>
	<FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.(woff2?|ttf|eot)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.(css|js)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
</IfModule>

# Force index variants to main homepage
RewriteRule ^index(?:\.html)?$ / [R=301,L]

# Force old alternate homepage to main homepage
RewriteRule ^index-2(?:\.html)?$ / [R=301,L]

# Redirect legacy blog routes to active pages
RewriteRule ^blog-grid(?:\.html)?$ /blog [R=301,L]
RewriteRule ^blog-classic(?:\.html)?$ /blog [R=301,L]
RewriteRule ^blog-details(?:\.html)?$ /blog-best-construction-company-kurunegala [R=301,L]

# Redirect legacy service details route to active page
RewriteRule ^service-details(?:\.html)?$ /services-details [R=301,L]

# Redirect discontinued duplicate about page to the maintained About Us page
RewriteRule ^about-company(?:\.html)?$ /about [R=301,L]

# Redirect discontinued duplicate home-construction page to house-construction
RewriteRule ^home-construction-sri-lanka(?:\.html)?$ /house-construction-sri-lanka [R=301,L]

# Redirect direct .html requests to extensionless URLs
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Serve extensionless URLs from matching .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Treat root as index.html
RewriteRule ^$ index.html [L]
